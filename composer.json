{
  "name": "etus/framework",
  "require": {
    "php": "^8.2",
    "symfony/var-dumper": "^8.0",
    "nikic/fast-route": "^1.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Etus\\Framework\\": "framework/",
      "App\\": "app/",
      "Config\\": "app/Config/",
      "Database\\Factories\\": "database/factories/"
